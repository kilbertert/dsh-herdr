{
  "name": "dsh-herdr",
  "version": "0.1.0",
  "description": "Embeds a Herdr terminal in the DSH sidebar and auto-connects to your remote Herdr session over the host PTY service.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilbertert/dsh-herdr.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "herdr",
    "terminal",
    "remote"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "icon.svg"
}
